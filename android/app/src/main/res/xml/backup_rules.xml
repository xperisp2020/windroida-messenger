<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Messaging databases, attachments, credentials, preferences and WebView state are private user data. -->
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="wd.xml" />
    <exclude domain="sharedpref" path="wd_internal_launch.xml" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
